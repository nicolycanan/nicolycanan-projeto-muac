# Copie este arquivo para .env.local e preencha com seus valores reais.
# .env.local nunca deve ser commitado (já está no .gitignore).

# Gere em https://www.notion.so/my-integrations
NOTION_TOKEN=

# Copie da URL da sua database no Notion (32 caracteres, sem hífens funciona também)
NOTION_DATABASE_ID=

# Opcional — indique o Data Source ID se quiser evitar resolução automática
NOTION_DATA_SOURCE_ID=

# Opcional — usado em app/sitemap.ts e app/robots.ts. Sem isso, cai para https://muac.site
NEXT_PUBLIC_SITE_URL=
