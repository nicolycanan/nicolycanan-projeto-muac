{
  "d1_databases": [
    {
      "binding": "muac_analytics",
      "database_name": "muac-analytics",
      "database_id": "f04a59c4-be0b-4c60-8a08-dde7bf188e79",
      "remote": true
    }
  ],
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "muac",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "muac"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}